# =============================================================================
# Database
# =============================================================================

# PostgreSQL connection string used by Drizzle ORM
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/postgres

# =============================================================================
# Better Auth
# =============================================================================

# Secret used to sign tokens and cookies (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-to-a-random-secret

# Server-side Better Auth URL (used in auth.ts)
BETTER_AUTH_URL=http://localhost:3000

# Client-side Better Auth URL (exposed to the browser, used in auth-client.ts)
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Application name shown in metadata and shared auth UI.
NEXT_PUBLIC_APP_NAME=Auth Provider

# Maximum concurrent browser accounts stored by Better Auth multi-session.
# AUTH_MAX_BROWSER_SESSIONS=5

# Enable Have I Been Pwned password checks. Defaults to true in production.
# AUTH_ENABLE_HIBP_PASSWORD_CHECKS=true

# Cloudflare Turnstile captcha for sign up, email sign in, and password reset requests.
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Better Auth OAuth Provider
# Docs: https://better-auth.com/docs/plugins/oauth-provider
#
# Comma-separated audiences (resource identifiers) your access tokens should be
# issued for. In most deployments this should be your API URL, not your frontend URL.
# If omitted, Better Auth falls back to BETTER_AUTH_URL.
# Example: single local API audience
# OAUTH_VALID_AUDIENCES=http://localhost:3000
# Example: production API + MCP resource server
# OAUTH_VALID_AUDIENCES=https://api.example.com,https://api.example.com/mcp
# Example: staging API
# OAUTH_VALID_AUDIENCES=https://staging-api.example.com

# Enable RFC 7591 dynamic client registration only when self-service or third-party
# clients need to create OAuth clients without an admin pre-registering them.
# Leave disabled for internal-only providers where admins create clients manually.
# Public unauthenticated registration is intentionally left disabled by default.
# OAUTH_ALLOW_DYNAMIC_CLIENT_REGISTRATION=false

# Cache trusted first-party client IDs in memory.
# These are useful for built-in/internal apps that should be treated as trusted
# and protected from runtime edits through the client management UI/API.
# OAUTH_TRUSTED_CLIENT_IDS=internal-dashboard,mobile-app
# Example: internal web app + CLI
# OAUTH_TRUSTED_CLIENT_IDS=admin-web,developer-cli

# Pairwise subject identifiers docs:
# https://better-auth.com/docs/plugins/oauth-provider#pairwise-subject-identifiers
#
# Pairwise subject identifiers replace the user's normal `sub` claim with a
# stable, client-specific identifier. The same user will therefore get a different
# `sub` value in each pairwise client, which helps prevent different apps from
# correlating that user across services.
#
# This only applies to OAuth clients registered with `subject_type=pairwise`.
# Important:
# - Use a long random secret (32+ chars; 256-bit recommended)
# - Treat it as permanent: rotating it changes every pairwise `sub`
# - Pairwise clients must keep all redirect URIs on the same host
# OAUTH_PAIRWISE_SUBJECT_SECRET=replace-with-a-long-random-secret

# =============================================================================
# Google OAuth
# =============================================================================
# Get these from: Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# =============================================================================
# Email (SMTP via Nodemailer, optional)
# =============================================================================
# Used for org invitation emails and password/email verification delivery.
# If SMTP_HOST is omitted, auth still works but outbound emails are skipped.
#
# Local dev:  Use Mailpit (docker: axllent/mailpit) — SMTP on :1025, UI on :8025
# Production: Point at your provider's SMTP (SendGrid, Postmark, Gmail, AWS SES)

# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=true
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# EMAIL_FROM="Auth Provider <noreply@localhost>"
