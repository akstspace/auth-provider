# =============================================================================
# Database
# =============================================================================

# PostgreSQL connection string used by Drizzle ORM
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/postgres

# =============================================================================
# Better Auth
# =============================================================================

# Secret used to sign tokens and cookies (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-to-a-random-secret

# Server-side Better Auth URL (used in auth.ts)
BETTER_AUTH_URL=http://localhost:3000

# Client-side Better Auth URL (exposed to the browser, used in auth-client.ts)
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Application name shown in metadata and shared auth UI.
NEXT_PUBLIC_APP_NAME=Auth Provider

# Maximum concurrent browser accounts stored by Better Auth multi-session.
# AUTH_MAX_BROWSER_SESSIONS=5

# Enable Have I Been Pwned password checks. Defaults to true in production.
# AUTH_ENABLE_HIBP_PASSWORD_CHECKS=true

# Cloudflare Turnstile captcha for sign up, email sign in, and password reset requests.
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Better Auth OAuth Provider
# Comma-separated audiences your resource servers will accept.
# Example: OAUTH_VALID_AUDIENCES=https://api.example.com,https://api.example.com/mcp
# If omitted, Better Auth falls back to BETTER_AUTH_URL.
# OAUTH_VALID_AUDIENCES=http://localhost:3000

# Enable RFC 7591 dynamic client registration when you explicitly need it.
# Public unauthenticated registration is intentionally left disabled by default.
# OAUTH_ALLOW_DYNAMIC_CLIENT_REGISTRATION=false

# Cache trusted first-party client IDs to prevent runtime edits and skip extra lookups.
# OAUTH_TRUSTED_CLIENT_IDS=internal-dashboard,mobile-app

# Optional 32+ character secret to support pairwise subject identifiers.
# OAUTH_PAIRWISE_SUBJECT_SECRET=replace-with-a-long-random-secret

# =============================================================================
# Google OAuth
# =============================================================================
# Get these from: Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# =============================================================================
# Email (SMTP via Nodemailer)
# =============================================================================
# Used for org invitation emails. Defaults to localhost:1025 (Mailpit) in dev.
#
# Local dev:  Use Mailpit (docker: axllent/mailpit) — SMTP on :1025, UI on :8025
# Production: Point at your provider's SMTP (SendGrid, Postmark, Gmail, AWS SES)

SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_SECURE=true
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
EMAIL_FROM="Auth Provider <noreply@localhost>"
